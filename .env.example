# GMAIL_APP_PASSWORD is a 16-character App Password (requires 2-Step
# Verification on the account) from https://myaccount.google.com/apppasswords
# — not the account's normal login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Comma-separated list of report recipients.
REPORT_RECIPIENTS=
